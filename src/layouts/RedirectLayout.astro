---
import {Font} from "astro:assets";
import "../assets/Styles.css";
import RedirectLayout from "../layouts/RedirectLayout.astro";

const access_token = Astro.url.searchParams.get("access_token") || ""
const token_type = Astro.url.searchParams.get("token_type") || ""
const expires_in = Astro.url.searchParams.get("expires_in") || ""
const MaxAgeInt = Number(expires_in)
const refresh_token = Astro.url.searchParams.get("refresh_token") || ""
const scope = Astro.url.searchParams.get("scope") || ""
Astro.cookies.set("access_token",access_token,{maxAge : MaxAgeInt})
Astro.cookies.set("scope",scope,{maxAge : MaxAgeInt})
Astro.cookies.set("refresh_token",refresh_token,{maxAge : MaxAgeInt})
Astro.cookies.set("token_type",token_type,{maxAge : MaxAgeInt})
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Redirect</title>
        <meta http-equiv="refresh" content="0; url=https://dizzybot.online/?LoggedIn"  />
	</head>
	<body>
        <a href="https://dizzybot.online/?LoggedIn"> If not Redirected please click this</a>
		<slot />
	</body>
</html>

