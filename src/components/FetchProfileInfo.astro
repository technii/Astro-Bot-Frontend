---
import { json } from 'astro:schema'
import '../assets/Styles.css'
import { fontProviders } from 'astro/config'
var formdata = new FormData()

const bearertokencookie = Astro.cookies.get("access_token")?.value || ""
console.log(bearertokencookie)
formdata.append("Token",bearertokencookie)
const userdata = await fetch("https://api.dizzybot.online/getprofiledata", {
    method:"POST",
    body:formdata
})
const userdatajson = await userdata.json()
---

<a href="https://dizzybot.online/?LoggedIn"> If not Redirected please click this</a>
<div>{userdatajson}</div>
